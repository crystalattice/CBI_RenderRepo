{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:renderrepo:s4-capsule:1",
  "title": "RenderRepo profile of an S4 capsule, version 1 (RR local contract)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "s4-capsule"
    },
    "profile": {
      "const": "renderrepo"
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "predecessor": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      ]
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "size_bytes",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "name",
        "workflow",
        "artifacts"
      ],
      "properties": {
        "schema_version": {
          "const": 0,
          "type": "integer"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "workflow": {
          "type": "string",
          "minLength": 1
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "filename"
            ],
            "properties": {
              "filename": {
                "type": "string",
                "minLength": 1
              },
              "target": {
                "type": "string"
              },
              "size_bytes": {
                "type": "integer",
                "minimum": 0
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{64}$"
              },
              "sources": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "uri"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "uri": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        },
        "description": {
          "type": "string"
        },
        "discovery": {
          "type": "object"
        },
        "capabilities": {
          "type": "object"
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "filename",
              "kind",
              "mode"
            ],
            "properties": {
              "filename": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "image",
                  "video"
                ]
              },
              "mode": {
                "enum": [
                  "user",
                  "bundled"
                ]
              }
            }
          }
        },
        "unresolved": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "node_packages": {
              "type": "array"
            },
            "requirements": {
              "type": "object"
            },
            "custom_nodes": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "source",
                  "revision"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "source": {
                    "type": "string",
                    "minLength": 1
                  },
                  "revision": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$"
                  }
                }
              }
            }
          }
        }
      }
    },
    "observations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "authoring_runtime": {
          "type": "object",
          "description": "Historical exporter source snapshot, not qualification of a receiving target."
        }
      }
    },
    "provenance": {
      "type": "object",
      "description": "Known source records; no signature or publisher attestation is implied.",
      "properties": {
        "source_records": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "s4": {
      "type": "null",
      "description": "Reserved. Cross-application meanings are pending; no values accepted."
    }
  },
  "required": [
    "format",
    "profile",
    "schema_version",
    "predecessor",
    "files",
    "payload_sha256",
    "sha256",
    "claims",
    "observations",
    "provenance",
    "s4"
  ],
  "description": "Structural schema only. The profile specification and backend also enforce payload membership/bytes, projections, safe paths, forbidden target-state claim fields, and deterministic hashes."
}
